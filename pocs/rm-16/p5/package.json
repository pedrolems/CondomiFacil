{
  "name": "poc-rm16-p5-migrations-acesso",
  "private": true,
  "type": "module",
  "description": "PoC P5 (RM-16): Flyway (P5a) e Kysely x Drizzle sob TenantContext (P5b). Pasta descartável, fora do workspace.",
  "engines": { "node": "26.13.1" },
  "scripts": {
    "subir": "node scripts/subir.mjs",
