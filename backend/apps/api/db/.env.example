# Banco local descartável (RM-25). Copiar para db/.env só se quiser escolher os valores:
# sem db/.env e sem as variáveis no ambiente, "pnpm db:instalar" gera senhas aleatórias em db/.env.
# Nunca use estas variáveis para banco remoto (Supabase, staging ou produção).
DB_SENHA_SUPERUSUARIO=
DB_SENHA_MIGRADOR=
DB_SENHA_APP=
DB_SENHA_APP_AUTENTICACAO=
DB_SENHA_FIXTURES=
# Opcionais (padrões entre parênteses).
# DB_HOST (127.0.0.1), DB_PORTA (54320), DB_NOME (condomifacil)
# DB_COMPOSE (1; 0 no CI, onde o Postgres é serviço do job)
# FLYWAY_REDE (condomifacil-db; host no CI), FLYWAY_DB_HOST (postgres; localhost no CI), FLYWAY_DB_PORTA (5432)
