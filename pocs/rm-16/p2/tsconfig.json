{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "isolatedModules": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "noUncheckedIndexedAccess": true, "types": ["node"]
  },
  "include": ["src", "test"]
}
