{
  "name": "@condomifacil/shared-types",
  "private": true,
  "description": "Tipos e esquemas de transporte gerados dos contratos OpenAPI e AsyncAPI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gerar-contratos": "node scripts/gerar.mjs",
    "verificar-contratos": "git diff --exit-code -- src/gerado",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.6",
    "@condomifacil/config": "workspace:*",
    "@redocly/openapi-core": "1.34.24",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
